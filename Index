<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GHUFRAN KING DIGITAL</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Poppins,sans-serif;}
body{background:#0a0a0a;color:#fff;}

/* HEADER */
header{
background:#111;
padding:15px 8%;
display:flex;
justify-content:space-between;
align-items:center;
border-bottom:1px solid #333;
position:sticky;top:0;
}
.logo{color:#f5b400;font-weight:700;font-size:22px;}
nav a{color:#fff;margin-left:15px;text-decoration:none;font-size:14px;}

/* HERO */
.hero{text-align:center;padding:90px 8%;background:linear-gradient(135deg,#111,#1a1a1a);}
.hero h1{color:#f5b400;font-size:45px;}
.hero p{color:#ccc;margin-top:10px;}
.btn{background:#f5b400;color:#000;padding:10px 18px;border-radius:8px;text-decoration:none;margin:8px;display:inline-block;font-weight:600;}

/* SECTIONS */
.section{padding:60px 8%;}
.section-title{text-align:center;color:#f5b400;font-size:32px;margin-bottom:30px;}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;}
.card{background:#111;padding:20px;border:1px solid #222;border-radius:12px;}

/* AUTH BOX */
.auth-container{
display:none;
position:fixed;
top:0;left:0;
width:100%;height:100%;
background:rgba(0,0,0,0.9);
justify-content:center;
align-items:center;
}

.auth-box{
background:#111;
padding:25px;
border-radius:12px;
width:300px;
border:1px solid #333;
}

.auth-box h2{color:#f5b400;margin-bottom:15px;text-align:center;}

.auth-box input{
width:100%;
padding:10px;
margin:8px 0;
background:#000;
border:1px solid #333;
color:#fff;
border-radius:6px;
}

.auth-box button{
width:100%;
padding:10px;
background:#f5b400;
border:none;
margin-top:10px;
font-weight:600;
cursor:pointer;
}

.switch{
text-align:center;
margin-top:10px;
color:#ccc;
font-size:12px;
cursor:pointer;
}

.close{
text-align:right;
cursor:pointer;
color:#f5b400;
}

/* USER PANEL */
#userPanel{
display:none;
text-align:center;
margin-top:20px;
}

.logout{
background:red;
color:#fff;
padding:8px 15px;
border:none;
border-radius:6px;
cursor:pointer;
}
</style>
</head>

<body>

<header>
<div class="logo">GHUFRAN KING DIGITAL</div>
<nav>
<a href="#" onclick="openAuth()">Login</a>
<a href="#courses">Courses</a>
<a href="#services">Services</a>
</nav>
</header>

<section class="hero">
<h1>Learn • Earn • Grow Online</h1>
<p>Digital Marketing, Freelancing & Web Development</p>

<a href="#" class="btn">Get Started</a>
<a href="https://wa.me/923113106280" class="btn">WhatsApp</a>

<div id="userPanel">
<h3>Welcome, <span id="userName"></span> 👑</h3>
<button class="logout" onclick="logout()">Logout</button>
</div>
</section>

<section class="section" id="courses">
<h2 class="section-title">Courses</h2>
<div class="grid">
<div class="card"><h3>Digital Marketing</h3></div>
<div class="card"><h3>Freelancing</h3></div>
<div class="card"><h3>Web Development</h3></div>
</div>
</section>

<!-- AUTH SYSTEM -->
<div class="auth-container" id="authBox">
<div class="auth-box">

<div class="close" onclick="closeAuth()">✖</div>

<h2 id="formTitle">Login</h2>

<input type="text" id="username" placeholder="Username">
<input type="password" id="password" placeholder="Password">

<button onclick="handleAuth()">Submit</button>

<div class="switch" onclick="toggleForm()">
Switch to Signup
</div>

</div>
</div>

<script>
let isLogin = true;

// open/close auth
function openAuth(){
document.getElementById("authBox").style.display="flex";
}
function closeAuth(){
document.getElementById("authBox").style.display="none";
}

// toggle login/signup
function toggleForm(){
isLogin = !isLogin;
document.getElementById("formTitle").innerText = isLogin ? "Login" : "Signup";
document.querySelector(".switch").innerText = isLogin ? "Switch to Signup" : "Switch to Login";
}

// auth system
function handleAuth(){
let user = document.getElementById("username").value;
let pass = document.getElementById("password").value;

if(isLogin){
let savedUser = localStorage.getItem("user");
let savedPass = localStorage.getItem("pass");

if(user === savedUser && pass === savedPass){
alert("Login Successful!");
loginUser(user);
}else{
alert("Invalid Credentials");
}

}else{
localStorage.setItem("user",user);
localStorage.setItem("pass",pass);
alert("Signup Successful! Now Login");
toggleForm();
}
}

// login user
function loginUser(name){
closeAuth();
document.getElementById("userPanel").style.display="block";
document.getElementById("userName").innerText = name;
}

// logout
function logout(){
localStorage.removeItem("user");
localStorage.removeItem("pass");
document.getElementById("userPanel").style.display="none";
alert("Logged Out");
}
</script>

</body>
</html>
